# ── FleetPulse AI — Environment Configuration Template ────────────────────
# Copy this file to .env.local and populate the required API keys.

# Google Gemini API Key
# Required to power the Autonomous Logistics Intelligence Engine (Gemini 3.6 Flash / Gemini 2.0).
# Obtain a free API key at: https://aistudio.google.com/apikey
# If this variable is omitted or left blank, the app will gracefully fall back
# to pre-calculated realistic mock telemetry and decision models.
GEMINI_API_KEY=your_gemini_api_key_here
